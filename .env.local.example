# Copy this file to .env.local and fill in the values to run locally.
# In production, set the same variables in Vercel:
#   Project → Settings → Environment Variables (Production, Preview, Development).
#
# .env.local is gitignored — never commit a real .env.local with secrets.

# -----------------------------------------------------------------------------
# Resend — transactional email provider
# -----------------------------------------------------------------------------
# Sign up at https://resend.com, verify the gsf.com.do domain (DNS records),
# then create an API key at https://resend.com/api-keys.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# Supabase — database for storing complaint submissions + admin auth
# -----------------------------------------------------------------------------
# Create a project at https://supabase.com. All values live in:
#   Settings → API
#
# SERVICE_ROLE_KEY (server-only): bypasses RLS, used by /api/complaints to
# insert public submissions.
#
# ANON_KEY + URL are exposed to the browser (prefixed NEXT_PUBLIC_) and used
# by Supabase Auth for the admin magic-link flow. Auth still requires a
# signed session cookie — see src/middleware.ts.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# Admin panel allowlist
# -----------------------------------------------------------------------------
# Comma-separated list of email addresses authorized to access /admin/*.
# Case-insensitive, whitespace-trimmed. Anything not in this list is rejected
# before a magic link is even sent. Per-user (not per-domain).
ADMIN_ALLOWLIST_EMAILS=andres.pichardo@gsf.com.do

# -----------------------------------------------------------------------------
# Email addresses that receive complaint notifications
# -----------------------------------------------------------------------------
# COMPLAINTS_NOTIFICATION_EMAIL is the shared fallback inbox. It is still
# required — the route refuses to start without it.
COMPLAINTS_NOTIFICATION_EMAIL=contacto@gsf.com.do
#
# Per-classification routing: reports are routed by who filed them.
#   internal (GSF employee)                 -> COMPLAINTS_NOTIFICATION_EMAIL_INTERNAL
#   external (community / supplier / third)  -> COMPLAINTS_NOTIFICATION_EMAIL_EXTERNAL
# If either is unset, that class falls back to COMPLAINTS_NOTIFICATION_EMAIL,
# so nothing breaks before these are configured in Vercel.
COMPLAINTS_NOTIFICATION_EMAIL_INTERNAL=reclamos@gsf.com.do
COMPLAINTS_NOTIFICATION_EMAIL_EXTERNAL=relaciones@gsf.com.do

# -----------------------------------------------------------------------------
# Cloudflare Turnstile — captcha on the /complaints form
# -----------------------------------------------------------------------------
# Create a widget at https://dash.cloudflare.com → Turnstile → Add site.
# The values below are Cloudflare's PUBLIC dev test keys: the site key always
# passes and the secret key always verifies OK. Use them locally so you do not
# need to register localhost in your real widget. Replace with real values in
# Vercel (Production + Preview environments).
#
# Dev test keys reference: https://developers.cloudflare.com/turnstile/troubleshooting/testing/
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# -----------------------------------------------------------------------------
# Upstash Redis — rate limiting on the /api/complaints route
# -----------------------------------------------------------------------------
# Create a Regional Redis DB at https://console.upstash.com (Free tier).
# Both values come from the database's "REST API" section.
# If these are unset, the route logs a warning and falls back to allowing all
# traffic — useful for local dev without an Upstash account.
UPSTASH_REDIS_REST_URL=https://xxxxxxxxxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# CRON_SECRET — protects the keep-alive cron (/api/cron/keepalive)
# -----------------------------------------------------------------------------
# A random string. Vercel injects `Authorization: Bearer <CRON_SECRET>` into
# scheduled cron invocations (see vercel.json), and the route rejects anything
# that does not match — so the endpoint cannot be triggered by the public.
# Generate one with:  openssl rand -hex 32
# Set it in Vercel (Production). Without it the keep-alive route returns 503.
CRON_SECRET=generate-a-random-hex-string

# -----------------------------------------------------------------------------
# (Optional) Production site URL — used by SEO files (sitemap, robots, JSON-LD).
# Defaults to the current Vercel staging URL if not set.
# Set this when GSF promotes to its production domain (e.g. gsf.com.do).
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_SITE_URL=https://gsf.com.do
